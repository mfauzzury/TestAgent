# ─── TestAgent Configuration ──────────────────────────────────────────────────

# Anthropic API Key (optional — only needed for AI assertions & failure analysis)
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Server port (default: 4000)
PORT=4000

# JWT secret (change this in production!)
JWT_SECRET=testagent-dev-secret-change-in-prod

# Use either a SQLite file URL (Prisma migrate always uses file: — see prisma.config.ts), or MySQL for runtime:
# DATABASE_URL="mysql://user:pass@host:3306/dbname"
# If DATABASE_URL is MySQL, TestAgent uses it at runtime when App Settings do not set dbEnabled:false.
# SQLITE_DATABASE_URL="file:./data/testAgent.db"   # optional explicit SQLite path when DATABASE_URL is MySQL
DATABASE_URL="file:./data/testAgent.db"
